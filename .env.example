# Development overrides. The signed macOS app chooses its own Application
# Support directory and keeps the browser prototype disabled.
RESEARCH_MEMORY_DATA_DIR=~/.research-memory
RESEARCH_MEMORY_HOST=127.0.0.1
RESEARCH_MEMORY_PORT=8765

# Network enrichment remains off until the user enables it in Settings.
# Only DOI/PMID identifiers are sent.
RESEARCH_MEMORY_ENABLE_NETWORK_METADATA=false
RESEARCH_MEMORY_CROSSREF_MAILTO=

# Production retrieval uses the pinned local ONNX model. "hash" is a
# development-only fallback when the model has not been installed.
RESEARCH_MEMORY_EMBEDDING_BACKEND=fastembed
RESEARCH_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RESEARCH_MEMORY_ALLOW_LEGACY_WEB=false
