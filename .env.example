# All paths default to a private directory in your home folder.
RESEARCH_MEMORY_DATA_DIR=~/.research-memory
RESEARCH_MEMORY_HOST=127.0.0.1
RESEARCH_MEMORY_PORT=8765

# Optional metadata enrichment. The application works without network access.
RESEARCH_MEMORY_ENABLE_CROSSREF=false
RESEARCH_MEMORY_CROSSREF_MAILTO=

# Embeddings: "hash" works immediately and offline. "sentence-transformers"
# provides stronger semantic recall after installing the optional dependency.
RESEARCH_MEMORY_EMBEDDING_BACKEND=hash
RESEARCH_MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional source-grounded synthesis through an OpenAI-compatible endpoint.
# Retrieval and evidence passages work without an LLM.
RESEARCH_MEMORY_LLM_BASE_URL=
RESEARCH_MEMORY_LLM_API_KEY=
RESEARCH_MEMORY_LLM_MODEL=
