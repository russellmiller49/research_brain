{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Memory",
  "version": "0.2.0",
  "identifier": "app.researchmemory.beta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Research Memory",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; font-src 'self' data:",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "copyright": "Copyright © 2026 Research Memory Contributors",
    "shortDescription": "Private research paper recall",
    "longDescription": "A local-first workspace for importing, finding, reading, and annotating research papers.",
    "externalBin": [
      "binaries/research-memory-core",
      "binaries/tesseract"
    ],
    "resources": [
      "resources/models",
      "resources/tessdata",
      "resources/tesseract-libs",
      "resources/legal"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 210
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "dangerousInsecureTransportProtocol": false
    }
  }
}
