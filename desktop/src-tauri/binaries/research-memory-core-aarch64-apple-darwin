#!/bin/sh
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
for CANDIDATE in \
  "$SCRIPT_DIR/../../../.venv-beta/bin/python" \
  "$SCRIPT_DIR/../../.venv-beta/bin/python" \
  "$SCRIPT_DIR/../../../../.venv-beta/bin/python"
do
  if [ -x "$CANDIDATE" ]; then
    exec "$CANDIDATE" -m research_memory.cli "$@"
  fi
done
echo "Research Memory development core was not found." >&2
exit 1
