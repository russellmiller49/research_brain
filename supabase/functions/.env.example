# Generate a 32-byte key, encode it as base64url, and store it only in the
# Supabase Edge Function secret store. Never expose this key to Vite.
RESEARCH_MEMORY_CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Exact browser origins allowed to start connector authorization.
RESEARCH_MEMORY_CLOUD_APP_ORIGINS=http://127.0.0.1:1420,http://127.0.0.1:1421

# Register this exact URL with Google and Microsoft.
RESEARCH_MEMORY_CLOUD_CONNECTOR_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/cloud-connectors/callback

RESEARCH_MEMORY_GOOGLE_DRIVE_CLIENT_ID=
RESEARCH_MEMORY_GOOGLE_DRIVE_CLIENT_SECRET=

RESEARCH_MEMORY_MICROSOFT_DRIVE_CLIENT_ID=
RESEARCH_MEMORY_MICROSOFT_DRIVE_CLIENT_SECRET=
RESEARCH_MEMORY_MICROSOFT_DRIVE_TENANT=common
