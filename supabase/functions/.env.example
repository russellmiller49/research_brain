# Generate a 32-byte key, encode it as base64url, and store it only in the
# Supabase Edge Function secret store. Never expose this key to Vite.
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Exact browser origins allowed to start connector authorization.
CLOUD_APP_ORIGINS=http://127.0.0.1:1420,http://127.0.0.1:1421

# Register this exact URL with Google and Microsoft.
CLOUD_CONNECTOR_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/cloud-connectors/callback

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

MICROSOFT_DRIVE_CLIENT_ID=
MICROSOFT_DRIVE_CLIENT_SECRET=
MICROSOFT_DRIVE_TENANT=common
