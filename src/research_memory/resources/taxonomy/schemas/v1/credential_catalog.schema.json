{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-memory.local/taxonomy/schemas/v1/credential_catalog.schema.json",
  "title": "Research Memory credential catalog snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_metadata",
    "nodes"
  ],
  "properties": {
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_name",
        "source_type",
        "source_url",
        "retrieved_date",
        "expected_member_boards",
        "expected_specialty_areas",
        "expected_subspecialty_areas",
        "source_notes"
      ],
      "properties": {
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "credential_catalog"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "retrieved_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "expected_member_boards": {
          "type": "integer",
          "minimum": 1
        },
        "expected_specialty_areas": {
          "type": "integer",
          "minimum": 1
        },
        "expected_subspecialty_areas": {
          "type": "integer",
          "minimum": 1
        },
        "source_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
